{
  "name": "@orchardworks/agent-remote-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent agent session control and protocol workbench.",
  "scripts": {
    "test:installer:windows": "node scripts/run-tests.mjs installer-windows",
    "start": "node scripts/start.mjs",
    "dev": "node scripts/dev.mjs",
    "debug:dsh": "node scripts/dsh-debug.mjs",
    "build": "pnpm compatibility:update && pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "node scripts/run-tests.mjs unit",
    "test:e2e": "node scripts/run-tests.mjs e2e",
    "test:conformance": "node scripts/run-tests.mjs conformance",
    "test:setup": "node scripts/run-tests.mjs setup",
    "compatibility:update": "node scripts/compatibility.mjs",
    "compatibility:check": "node scripts/compatibility.mjs --check",
    "lint:docs": "bash scripts/lint-mermaid.sh docs",
    "bdb": "node packages/agent-remote-debugger/dist/cli.js",
    "agent-remote-controller": "node packages/agent-host/dist/cli.js",
    "test:copilot": "node scripts/run-tests.mjs copilot",
    "start:gateway-relay": "pnpm --filter @orchardworks/agent-remote-lab exec tsx src/server/gateway.ts",
    "test:gateway-relay": "node scripts/test-gateway-relay.mjs",
    "test:preview-browser": "node scripts/run-tests.mjs preview-browser",
    "test:cloudflare": "node scripts/run-tests.mjs cloudflare",
    "build:relay": "node scripts/build-relay.mjs",
    "relay:local": "node scripts/relay-local.mjs",
    "build:agent-remote-controller": "node scripts/build-agent-host.mjs",
    "test:agent-remote-controller-package": "node scripts/run-tests.mjs host-package",
    "test:windows": "node scripts/run-tests.mjs host-windows && node scripts/run-tests.mjs codex-transport && node scripts/run-tests.mjs windows-services && node scripts/run-tests.mjs image-input",
    "test:controller-updates": "node scripts/run-tests.mjs controller-updates && node scripts/run-tests.mjs controller-updates-web && node scripts/run-tests.mjs controller-updates-relay",
    "test:codex-shared": "node scripts/run-tests.mjs codex-shared"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  }
}
