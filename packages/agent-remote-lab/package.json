{
  "name": "@orchardworks/agent-remote-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Protocol validation site for provider-neutral remote agent sessions.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run --testTimeout=10000 --maxWorkers=50% --exclude '**/*.local.test.ts' --exclude '**/*.local.test.tsx'"
  },
  "dependencies": {
    "@orchardworks/agent-client": "workspace:*",
    "@orchardworks/agent-client-web": "workspace:*",
    "@orchardworks/agent-provider-codex": "workspace:*",
    "@orchardworks/agent-provider-dsh": "workspace:*",
    "@orchardworks/agent-provider-sdk": "workspace:*",
    "@orchardworks/agent-relay-core": "workspace:*",
    "@orchardworks/agent-remote-journal": "workspace:*",
    "@orchardworks/agent-remote-protocol": "workspace:*",
    "@orchardworks/agent-session-runtime": "workspace:*",
    "@orchardworks/dsh": "workspace:*",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@orchardworks/agent-e2e": "workspace:*",
    "@orchardworks/agent-provider-claude": "workspace:*",
    "@orchardworks/agent-relay-node": "workspace:*",
    "@orchardworks/agent-remote-controller": "workspace:*",
    "@playwright/test": "^1.50.0",
    "@types/node": "^24.3.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vitest": "4.1.11",
    "ws": "^8.21.0"
  }
}
