{
  "name": "@orchardworks/agent-remote-debugger",
  "description": "Session View debugging through the shared Agent Remote protocol and client.",
  "version": "0.1.0",
  "private": false,
  "publishConfig": {
    "access": "public",
    "exports": {
      "./server": {
        "types": "./dist/server.d.ts",
        "import": "./dist/server.js"
      },
      "./dist/*": "./dist/*"
    }
  },
  "type": "module",
  "bin": {
    "ardb": "./dist/cli.js"
  },
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./testing/browser-prefix-adapter": {
      "types": "./e2e/fixtures/browser-prefix-adapter.d.mts",
      "import": "./e2e/fixtures/browser-prefix-adapter.mjs"
    },
    "./testing/session-view": "./web/session-view.tsx",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node scripts/build-local-succession.mjs && node scripts/build-adapters.mjs && node scripts/build-web.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run --testTimeout=10000",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.247",
    "@github/copilot": "1.0.83",
    "@github/copilot-sdk": "1.0.11",
    "@opencode/client": "2.0.25",
    "@orchardworks/agent-client": "workspace:*",
    "@orchardworks/agent-client-web": "workspace:*",
    "@orchardworks/agent-provider-codex": "workspace:*",
    "@orchardworks/agent-provider-sdk": "workspace:*",
    "@orchardworks/agent-remote-protocol": "workspace:*",
    "@orchardworks/agent-session-runtime": "workspace:*",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@orchardworks/agent-provider-claude": "workspace:*",
    "@orchardworks/agent-provider-copilot": "workspace:*",
    "@orchardworks/agent-provider-opencode": "workspace:*",
    "@orchardworks/agent-provider-pi": "workspace:*",
    "@orchardworks/agent-provider-sdk": "workspace:*",
    "@orchardworks/agent-relay-node": "workspace:*",
    "@orchardworks/agent-remote-controller": "workspace:*",
    "@orchardworks/agent-remote-lab": "workspace:*",
    "@playwright/test": "^1.50.0",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.7.0",
    "vitest": "4.1.11"
  }
}
