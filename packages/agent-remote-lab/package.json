{
  "name": "agent-remote-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Protocol validation site for provider-neutral remote agent sessions.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json && vite build",
    "build:dsh-plugin": "node --import tsx/esm scripts/build-dsh-plugin.ts",
    "prepare:dsh-release": "node --import tsx/esm scripts/prepare-dsh-release.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run --testTimeout=10000",
    "test:conformance": "node scripts/run-relay-conformance.mjs"
  },
  "dependencies": {
    "@borgee/agent-provider-codex": "workspace:*",
    "@borgee/agent-provider-dsh": "workspace:*",
    "@borgee/agent-provider-sdk": "workspace:*",
    "@borgee/agent-remote-protocol": "workspace:*",
    "@borgee/agent-remote-relay": "workspace:*",
    "@borgee/agent-remote-web": "workspace:*",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "@agent-remote-control/dsh": "workspace:*"
  },
  "devDependencies": {
    "@borgee/agent-host": "workspace:*",
    "@playwright/test": "^1.50.0",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.1",
    "jsdom": "^25.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.5",
    "ws": "^8.21.0"
  }
}
