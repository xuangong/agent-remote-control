{
  "name": "@orchardworks/agent-client",
  "version": "0.1.1",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Headless client for remote agent sessions: connection, session client, replica, device store, pending messages and the lease and send-state tables. It imports no React or DOM.",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./device-store": {
      "types": "./dist/device-store.d.ts",
      "import": "./dist/device-store.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --testTimeout=10000"
  },
  "dependencies": {
    "@orchardworks/agent-remote-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.0",
    "vitest": "4.1.11",
    "ws": "^8.21.0",
    "@orchardworks/agent-timeline": "workspace:*",
    "@orchardworks/agent-provider-sdk": "workspace:*"
  }
}
