# Production Node Docker configuration. Configure the same auth values on Gateway.
AGENT_REMOTE_RELAY_URL=https://agents.xianliao.de5.net
AGENT_REMOTE_ISSUER=https://token.xianliao.de5.net
# Generate with openssl rand -base64 32. Never commit the actual secret.
AGENT_REMOTE_SIGNING_SECRET=replace-with-a-random-shared-secret
AGENT_REMOTE_PORT=5910
AGENT_REMOTE_IMAGE=agent-remote-control:local
