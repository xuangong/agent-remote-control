  "edges": [
    {
      "id": "relay-knows-controller",
      "rule": 6,
      "from": [
        "relay-core",
        "relay-core-edge"
      ],
      "to": [
        "session-runtime",
        "controller",
        "controller-process",
        "client",
        "client-web",
        "provider-claude",
        "provider-codex",
        "provider-copilot",
        "provider-opencode",
        "provider-dsh"
      ],
      "comment": "The Relay does not know the Controller or the client: relay core never imports providers, the session runtime, the Controller or the client library."
    },
    {
      "id": "controller-knows-relay",
      "rule": 7,
      "from": [
        "controller",
        "controller-process"
      ],
      "to": [
        "relay-core",
        "relay-core-edge",
        "relay-node",
        "relay-cloudflare"
      ],
      "comment": "The Controller talks to the Relay only through the protocol and its own RelayLink port."
    },
    {
      "id": "controller-concrete-provider",
      "rule": 7,
      "from": [
        "controller",
        "controller-process"
      ],
      "to": [
        "provider-claude",
        "provider-codex",
        "provider-copilot",
        "provider-opencode",
        "provider-dsh"
      ],
      "exceptFiles": [
        "packages/agent-controller/src/providers.ts"
      ],
      "comment": "The Controller names concrete providers only in providers.ts, its composition root."
    },
    {
      "id": "client-knows-server",
      "rule": 8,
      "from": [
        "client",
        "client-web"
      ],
      "to": [
        "relay-core",
        "relay-core-edge",
        "relay-node",
        "relay-cloudflare",
        "controller",
        "controller-process",
        "session-runtime"
      ],
      "comment": "The client imports the protocol only."
    },
    {
      "id": "provider-imports",
      "rule": 5,
      "from": [
        "provider-claude",
        "provider-codex",
        "provider-copilot",
        "provider-opencode",
        "provider-dsh"
      ],
      "to": [
        "relay-core",
        "relay-core-edge",
        "relay-node",
        "relay-cloudflare",
        "controller",
        "controller-process",
        "client",
        "client-web",
        "session-runtime",
        "timeline",
        "journal"
      ],
      "comment": "Provider adapters import only the SDK, the protocol and their native client library."
    }
  ],
  "bans": [
    {
      "id": "domain-impure",
      "rule": 3,
      "modules": [
        "timeline",
        "journal",
        "relay-session-control"
      ],
      "imports": [
        "node:*"
      ],
      "code": [
        "Date\\.now\\(",
        "Math\\.random\\(",
        "\\bsetTimeout\\(",
        "\\bsetInterval\\(",
        "\\bprocess\\.",
        "\\bfetch\\(",
        "\\brandomUUID\\b",
        "new Date\\(\\)",
        "\\bperformance\\.now\\("
      ],
