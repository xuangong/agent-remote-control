{
  "name": "@agent-remote-controller/agent-remote-relay",
  "version": "0.1.1",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Standalone serialized relay for provider-neutral agent sessions.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --testTimeout=10000"
  },
  "dependencies": {
    "@agent-remote-controller/agent-provider-sdk": "workspace:*",
    "@agent-remote-controller/agent-remote-protocol": "workspace:*",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  }
}
