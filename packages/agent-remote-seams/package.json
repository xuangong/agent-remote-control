{
  "name": "@orchardworks/agent-remote-seams",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Seam tests: each connection between two modules is tested with mock data against the written contract in docs/current/agent-remote/seams.md. No source of its own.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --testTimeout=1000",
    "contracts:record": "vitest run --config vitest.record.config.ts"
  },
  "devDependencies": {
    "@orchardworks/agent-provider-claude": "workspace:*",
    "@orchardworks/agent-provider-codex": "workspace:*",
    "@orchardworks/agent-provider-copilot": "workspace:*",
    "@orchardworks/agent-provider-sdk": "workspace:*",
    "@orchardworks/agent-relay-core": "workspace:*",
    "@orchardworks/agent-remote-fixtures": "workspace:*",
    "@orchardworks/agent-remote-journal": "workspace:*",
    "@orchardworks/agent-remote-journal-sqlite": "workspace:*",
    "@orchardworks/agent-remote-protocol": "workspace:*",
    "@types/node": "^24.3.0",
    "typescript": "^5.7.0",
    "vitest": "4.1.11"
  }
}
