{
  "name": "@orchardworks/agent-remote-controller",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "bin": {
    "agent-remote-controller": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./journal-publisher": {
      "types": "./dist/journal-publisher.d.ts",
      "import": "./dist/journal-publisher.js"
    },
    "./local-session-succession": {
      "types": "./dist/local-session-succession.d.ts",
      "import": "./dist/local-session-succession.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --testTimeout=10000 --maxWorkers=50%",
    "test:unit": "vitest run --project unit --testTimeout=10000 --maxWorkers=50%",
    "test:process": "vitest run --project process --testTimeout=10000 --maxWorkers=50%"
  },
  "dependencies": {
    "@orchardworks/agent-provider-claude": "workspace:*",
    "@orchardworks/agent-provider-codex": "workspace:*",
    "@orchardworks/agent-provider-copilot": "workspace:*",
    "@orchardworks/agent-provider-opencode": "workspace:*",
    "@orchardworks/agent-provider-sdk": "workspace:*",
    "@orchardworks/agent-remote-hosted": "workspace:*",
    "@orchardworks/agent-remote-journal": "workspace:*",
    "@orchardworks/agent-remote-protocol": "workspace:*",
    "@orchardworks/agent-session-runtime": "workspace:*",
    "@orchardworks/agent-remote-tunnel": "workspace:*",
    "qrcode": "1.5.4",
    "ws": "^8.21.0",
    "@orchardworks/agent-platform": "workspace:*",
    "@orchardworks/agent-timeline": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/qrcode": "1.5.6",
    "@types/ws": "^8.18.1",
    "jsqr": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
