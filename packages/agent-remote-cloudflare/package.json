  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260601.1",
    "@types/node": "^24.3.0",
    "esbuild": "^0.28.1",
    "miniflare": "4.20260601.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5",
    "wrangler": "4.97.0"
  }
}
