{
  "version": 1,
  "description": "Module map for pnpm arch:check. Each source and test file under packages belongs to the module whose most specific path matches it. Modules are named by their target role (docs/superpowers/specs/2026-11-18-target-architecture-and-tests.md, section 3) and placed where the code lives today. Layers: 0 contracts, 1 domain, 2 application, 3 adapters, 4 apps, 5 test support (may import any layer). `edges`, `bans` and `roots` encode rules 3 and 5 to 10 of section 1.2; the others are structural. Violations that cannot be fixed yet are listed in architecture/exceptions.json with the step that removes them.",
  "scan": [
    "packages/*/src/**",
    "packages/*/test/**",
    "packages/*/e2e/**",
    "packages/agent-remote-seams/tests/**",
    "packages/agent-remote-fixtures/record/**",
    "packages/agent-e2e/faults/**",
    "packages/agent-e2e/smoke/**"
  ],
  "wireModules": [
    "protocol"
  ],
  "wireTestExempt": [
    "fixtures",
    "seams",
    "protocol",
    "protocol-fixtures",
    "e2e"
  ],
