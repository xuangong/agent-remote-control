#!/bin/sh
# There is no hosted CI, so a branch push runs the checks a release relies on: the compatibility check,
# the full build and type check, and the unit suites of the packages the push changes and of the packages
# that depend on them. A push that changes workspace files outside packages/ and docs/, such as scripts,
# the lockfile or this hook, runs every suite; so does `pnpm verify`, which releases still rely on.
# Native CLI suites depend on this machine's installed agents; run them with `pnpm test:local`.
zero=0000000000000000000000000000000000000000
branches=0
base=
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/*)
    [ "$local_sha" = "$zero" ] && continue
    branches=$((branches + 1))
    # A new branch, or a remote commit this clone does not have, compares with the shared history.
    if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then base=$remote_sha
    else base=$(git merge-base "$local_sha" origin/main 2>/dev/null); fi
    pushed=$local_sha ;;
  esac
done
[ "$branches" -gt 0 ] || exit 0
cd "$(git rev-parse --show-toplevel)" || exit 1
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo 'pre-push: commit or stash tracked changes so the checks run on what is pushed.' >&2
  exit 1
fi
pnpm install --frozen-lockfile --offline >/dev/null || exit 1
if [ "$branches" -ne 1 ] || [ -z "$base" ] || git diff --name-only "$base" "$pushed" | grep -qvE '^(packages|docs)/'; then
  exec pnpm verify
fi
echo "pre-push: testing the packages changed since $(git rev-parse --short "$base") and their dependents." >&2
pnpm compatibility:check && pnpm -r run build && pnpm typecheck && exec node scripts/run-tests.mjs affected "$base"
