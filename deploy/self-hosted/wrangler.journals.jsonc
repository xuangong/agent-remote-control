{
  "$schema": "../../packages/agent-relay-cloudflare/node_modules/wrangler/config-schema.json",
  // The Worker that holds the journal partitions. Deploy it before the Relay Worker: the Relay's JOURNALS binding
  // names it. It answers no request; only your Relay Worker calls it.
  "name": "my-agent-remote-journals",
  "main": "../../dist/cloudflare/journals.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "JOURNALS", "class_name": "JournalPartition" }], "code_update_strategy": { "mode": "immediate" } },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["JournalPartition"] }]
}
