{
  "name": "@agent-remote-controller/agent-remote-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Native Cloudflare Worker and SQLite Durable Object for authenticated Agent Remote Relay.",
  "scripts": {
    "build": "node scripts/build.mjs",
