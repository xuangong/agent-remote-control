# Copy to .env. This file is for a private deployment; never commit real secrets.
AGENT_REMOTE_RELAY_URL=https://agents.example.com
AGENT_REMOTE_AUTH_PROVIDER=google
# Generate once with: openssl rand -hex 32. Preserve it across upgrades/restores.
AGENT_REMOTE_SIGNING_SECRET=replace-with-at-least-32-random-bytes
AGENT_REMOTE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
AGENT_REMOTE_GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
AGENT_REMOTE_GOOGLE_ALLOWED_EMAILS=owner@example.com
# Required only for gateway auth. Set to your own compatible Gateway issuer.
# AGENT_REMOTE_ISSUER=https://gateway.example.com
# Host-side loopback port; the container continues to listen on 5910.
AGENT_REMOTE_HTTP_PORT=5910
# Optional preview origins require corresponding TLS/routing configuration.
# AGENT_REMOTE_PREVIEW_URL=https://preview.example.com
# AGENT_REMOTE_PREVIEW_DOMAIN=preview.example.com
